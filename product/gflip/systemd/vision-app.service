[Unit]
Description=Vision QC FastAPI + ONNX AI service
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=taza
WorkingDirectory=/home/taza/vision-stack/app
ExecStart=/home/taza/vision-stack/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
