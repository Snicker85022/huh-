[Unit]
Description=Taza Print Service (Zebra label printing for kanban/QC/apps)
After=network.target

[Service]
User=taza
WorkingDirectory=/home/taza/print-app
ExecStart=/home/taza/vision-stack/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8096
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
