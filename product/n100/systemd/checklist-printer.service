[Unit]
Description=Taza checklist print path self-heal (USB-first: probe ipp-usb endpoint, repair queue + class + spool)
Documentation=file:/home/taza/checklist-app/printer-selfheal.sh
After=cups.service ipp-usb.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=taza
ExecStart=/home/taza/checklist-app/printer-selfheal.sh
TimeoutStartSec=180
Nice=10

[Install]
WantedBy=multi-user.target
