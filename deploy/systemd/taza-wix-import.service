[Unit]
Description=Taza OS — Wix platter-store order/payment import into PostgreSQL
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# Adjust paths/user to match the N100 deployment.
User=taza
WorkingDirectory=/opt/taza-os/pipelines/wix_import
EnvironmentFile=/opt/taza-os/pipelines/wix_import/.env
ExecStart=/opt/taza-os/pipelines/wix_import/.venv/bin/python wix_import.py
# Don't hammer Wix/DB on transient failure; the timer will retry next cycle.
Nice=10

[Install]
WantedBy=multi-user.target
