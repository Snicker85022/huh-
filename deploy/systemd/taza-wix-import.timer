[Unit]
Description=Taza OS — run the Wix import on a schedule

[Timer]
# Every 30 minutes, plus ~5 min after boot. Catches new orders / payment updates.
OnBootSec=5min
OnUnitActiveSec=30min
# Spread load / avoid exact-minute stampede.
RandomizedDelaySec=60
Persistent=true
Unit=taza-wix-import.service

[Install]
WantedBy=timers.target
