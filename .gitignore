.aider*
*.db
job_runner/__pycache__/
job_runner/scheduler/data/
job_runner/scheduler/__pycache__/
job_runner/scheduler/scheduler.env
job_runner/scheduler/tests/__pycache__/
job_runner/.venv/
*.pyc
__pycache__/
.pytest_cache/
.venv/
secrets/

# ── derived artifacts: machine-written, never hand-edited, never a source of truth ──
# (README-FIRST: the databases ARE the authority; these are copies that churn on a timer)
factory/index/index.json
factory/index/index.tsv
factory/index/stats.json
factory/index/build.log
factory/spec-export/specs.csv
factory/spec-export/specs.meta.json
factory/spec-export/watch.log
factory/team-log/**
# ...except the documents worth keeping: the proposals, and the receipts of rows
# actually written into the spec database. Everything else (per-turn transcripts,
# LATEST-reply.md) stays out. Match case-insensitively so a receipt cannot be
# dropped by capitalisation.
!factory/team-log/SPEC-PROPOSAL-*.md
!factory/team-log/[Ll][Oo][Aa][Dd][Ee][Dd]-*.sql
factory/fusion-harness/**/*.bak-*
factory/fusion-harness/*.bak-*

# ── hand-maintained INVENTORY stays out of git (D149, 2026-10-16) ──────────────
# devices.json and roles.json are edited by hand, not generated, and they already
# carry `updated` + `verified_by`. Versioning them would make every inventory tweak
# a commit and a conflict, for no gain over the decision log. Equipment and role
# changes are recorded as DECISIONS instead, naming the file and its new timestamp —
# the same split as specs: the record lives in the database, the artifact carries a
# stamp. The CODE that reads them IS versioned; the data is not.
factory/arch/devices.json
factory/arch/roles.json
factory/arch/ledger.json
factory/arch/ip_mac_map.json
# the live router read is generated every 5 minutes by er605_pull.sh
factory/arch/er605_live.json
# and 150KB of backup churn that should not be in the repo
factory/arch/*.bak
factory/arch/*.bak-*
factory/arch/*.bak.*
