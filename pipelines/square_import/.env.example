# Taza OS — Square import pipeline configuration.
# Copy to .env on the N100 and fill in. NEVER commit the real .env.

# Square access token (production). Keep this secret.
SQUARE_ACCESS_TOKEN=

# PostgreSQL connection string for the taza_ops database.
DATABASE_URL=postgres://taza@localhost:5432/taza_ops

# Optional: restrict to one location. If unset, all ACTIVE locations import.
# Taza's live location id (discovered 2026-07-16):
SQUARE_LOCATION_ID=LC795JJQ45MYX

# Optional overrides (defaults shown)
# SQUARE_API_BASE=https://connect.squareup.com
# SQUARE_API_VERSION=2025-01-23
