# Taza OS — Wix import pipeline configuration.
# Copy to .env on the N100 and fill in. NEVER commit the real .env.

# Wix account API key (production). Keep this secret.
WIX_API_KEY=

# The Wix site the platter store belongs to (required to scope the API key).
WIX_SITE_ID=

# PostgreSQL connection string for the taza_ops database.
DATABASE_URL=postgres://taza@localhost:5432/taza_ops

# Optional overrides (defaults shown)
# WIX_API_BASE=https://www.wixapis.com

# Which order paymentStatuses to import (comma-separated). Paid-only by default,
# matching the "customer pays -> order fires" trigger.
# WIX_PAYMENT_STATUSES=PAID

# If set, only import orders updated within the last N days (incremental runs).
# Leave unset to sweep all paid orders each run (hash-skip makes this cheap).
# WIX_UPDATED_AFTER_DAYS=30
