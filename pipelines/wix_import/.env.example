# Taza OS — Wix import pipeline configuration.
# Copy to .env on the N100 and fill in. NEVER commit the real .env.

# Wix account API key (dashboard -> Settings -> API Keys). Keep this secret.
WIX_API_KEY=

# The site id the platter store lives on (required for site-scoped calls).
WIX_SITE_ID=

# PostgreSQL connection string for the taza_ops database.
DATABASE_URL=postgres://taza@localhost:5432/taza_ops

# Optional: only import orders created within the last N days (bounds the scan
# on the full-catalog runs). Unset = import all orders.
# WIX_ORDERS_SINCE_DAYS=90

# Optional override (default shown)
# WIX_API_BASE=https://www.wixapis.com
